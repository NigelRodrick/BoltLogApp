rules_version = '2';

// Authenticated users can read/write all paths (drivers/, senders/, etc.).
// Deploy: npx firebase-tools deploy --only storage (or: npm i -g firebase-tools then firebase deploy --only storage)
service firebase.storage {
  match /b/{bucket}/o/{allPaths=**} {
    allow read, write: if request.auth != null;
  }
}
