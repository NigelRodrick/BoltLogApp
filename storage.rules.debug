// TEMPORARY DEBUG RULES - Use only to test if uploads work.
// If this fixes it, the issue is with path matching. Revert to storage.rules after testing.
// Deploy: npx firebase-tools deploy --only storage
// (Copy this to storage.rules first, or: firebase deploy --only storage --config firebase.json with storage.rules pointing here)
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow any authenticated user to read/write drivers/ and senders/
    // This is INSECURE - only for debugging!
    match /drivers/{pathKey}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /senders/{pathKey}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
